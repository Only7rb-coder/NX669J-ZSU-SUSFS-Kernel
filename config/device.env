# NX669J / RedMagic 6 Android 12 build contract
KERNEL_REPO=https://github.com/tangalbert919/android_kernel_nubia_sm8350.git
KERNEL_REF=rebase-17200-a12
KERNEL_DEFCONFIG=vendor/lahaina-qgki_defconfig
KERNEL_ARCH=arm64
KERNEL_IMAGE=arch/arm64/boot/Image
NUBIA_TARGET_PRODUCT=NX669J
TARGET_BUILD_VARIANT=user
PRODUCT_BUILD_NX669J_S=false
PRODUCT_BUILD_NX669J_N=false
TARGET_NUBIA_SSD=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_REF=kernel-5.4
SUSFS_PATCH=kernel_patches/50_add_susfs_in_kernel-5.4.patch
# KernelSU-Next v3.1.0-legacy expects the v2.x SUSFS API. Keep the 5.4
# branch for its source patch, but take the common v2.3 implementation payload
# from the Android 12/5.10 branch.
SUSFS_API_REF=gki-android12-5.10
# The current dev-susfs head targets newer SELinux internals and fails on 5.4.147.
# This upstream legacy-susfs tag retains the 5.4 compatibility paths and SUSFS v2.x.
KSU_REPO=https://github.com/KernelSU-Next/KernelSU-Next.git
KSU_REF=v3.1.0-legacy
KSU_SETUP_URL=https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/v3.1.0-legacy/kernel/setup.sh

ZSU_MANAGER_DER_LENGTH=0x318
ZSU_MANAGER_CERT_SHA256=ba1159a5819dec96cdcb2498bef73170b0ba1735c12139bde1b7677bf7c5c2ab

# The NX669J device-tree reference uses recovery-as-boot and header v3.
# Do not infer a flash target from this file alone; inspect the stock image.
BOOT_HEADER_VERSION=3
BOOT_PARTITION=boot
VENDOR_BOOT_PARTITION=vendor_boot

# The upstream kernel-5.4 SUSFS patch targets a slightly different 5.4 tree.
# The build script applies it with bounded fuzz and ports fs/proc/fd.c.
SUSFS_NEEDS_FD_PORT=true
SUSFS_HAS_PROC_BOOTCONFIG=false
